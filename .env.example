# Copie para .env.local e preencha. NUNCA publique este arquivo preenchido.

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Somente servidor (agendador). Nunca use NEXT_PUBLIC_ nesta chave.
SUPABASE_SERVICE_ROLE_KEY=

# Segredo que protege /api/cron/tick (mínimo 16 caracteres, aleatório). O MESMO valor vai no SQL do agendador.
CRON_SECRET=

# Google AI Studio (Gemini). Somente servidor.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Fase 2+ (ainda NAO usadas nesta versao):
# SHOPEE_APP_ID=
# SHOPEE_SECRET=
# AMAZON_ACCESS_KEY=
# AMAZON_SECRET_KEY=
# AMAZON_PARTNER_TAG=

